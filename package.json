{
  "name": "blog-platform-monorepo",
  "version": "1.0.0",
  "description": "Full-Stack Blogging Platform (React + Vite + Node.js + Express + MongoDB)",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": ["blog", "react", "nodejs", "mongodb", "fullstack"],
  "author": "",
  "license": "MIT"
}
